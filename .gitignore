node_modules/

# Per-user data: settings, favourites, the follow list and the seat cache.
# Created on first run; never shared.
data/

# Build output. `npm run dist` regenerates both from source (it runs
# tools/make-icon.js first), so committing them would just be a stale 79 MB.
dist/
build/

# Dev scratch: server stdout/stderr when started detached.
s.out
s.err
*.log

# Test fixtures ARE committed — they are the regression suite. Only the
# throwaway capture scratch is ignored.
tests/fixtures/*.tmp

.DS_Store
Thumbs.db
.vscode/
.idea/
